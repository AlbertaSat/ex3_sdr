  parameters:
    comment: ''
    gui_hint: ''
    label: center_freq
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-50000'
    step: '50'
    stop: '50000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1544, 152.0]
    rotation: 0
    state: true
- name: dec_cc
