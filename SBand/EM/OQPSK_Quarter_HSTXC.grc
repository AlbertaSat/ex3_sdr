options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: OQPSK_Quarter_HSTXC
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: '[EX3-CM] S Band Receiver'
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: agc
  id: variable_qtgui_check_box
  parameters:
    comment: USRP AGC Toggle
    'false': Disabled
    gui_hint: settings@0:1,0,1,1
    label: AGC
    'true': Enabled
    type: string
    value: Disabled
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1776, 320.0]
    rotation: 0
    state: enabled
- name: antenna
  id: variable_qtgui_chooser
  parameters:
    comment: Antenna selector
    gui_hint: settings@0:0,0,1,1
    label: USRP Antenna Connection
    label0: RX2
    label1: TRX
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: RX2
    option1: TRX
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: string
    value: RX2
    widget: radio_buttons
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1776, 136.0]
    rotation: 0
    state: enabled
