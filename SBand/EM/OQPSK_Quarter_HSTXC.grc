    file: recording_path+str(datetime.fromtimestamp(time.time()).strftime("%Y-%m-%dT%H.%M.%S"))+rec_note+"_DECODED.bin"
      if dec_rec else null_path
    type: byte
    unbuffered: 'False'
    vlen: '1'
  states:
