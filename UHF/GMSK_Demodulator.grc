  id: digital_hdlc_deframer_bp
  parameters:
    affinity: ''
    alias: ''
    comment: 'Each frame from the UTRX-A will have a total of 16 bytes in the header.

      The maximum size will be 16 header bytes + 256 payload bytes + 2 CRC bytes'
    max: '274'
    maxoutbuf: '0'
    min: '16'
    minoutbuf: '0'
  states:
