    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, trim_len=16):\n        gr.sync_block.__init__(self,\
      \ name='trim_pdu', in_sig=None, out_sig=None)\n        self.trim_len = trim_len\n\
      \        self.message_port_register_in(pmt.intern('in'))\n        self.message_port_register_out(pmt.intern('out'))\n\
      \        self.set_msg_handler(pmt.intern('in'), self.handle_msg)\n\n    def\
      \ handle_msg(self, msg):\n        meta = pmt.car(msg)\n        data = pmt.cdr(msg)\n\
      \        vec = pmt.u8vector_elements(data)\n        trimmed = vec[self.trim_len:]\n\
      \        new_vec = pmt.init_u8vector(len(trimmed), trimmed)\n        self.message_port_pub(pmt.intern('out'),\
      \ pmt.cons(meta, new_vec))"
    affinity: ''
    alias: ''
    comment: 'Trim the header bytes  (first 16) off of each packet since we only want
      the payload data.

      The two CRC bytes at the end get discarded by the previous funciton.'
    maxoutbuf: '0'
    minoutbuf: '0'
    trim_len: '16'
  states:
    _io_cache: ('trim_pdu', 'blk', [('trim_len', '16')], [('in', 'message', 1)], [('out',
      'message', 1)], '', ['trim_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 456.0]
    rotation: 0
    state: enabled
